      "parameters": {
        "content": "## 1. Script Creation\n\nGenerates and refines script to 30 seconds",
        "height": 80,
        "width": 280,
        "color": 4
      },
      "id": "note-script",
      "name": "Script Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [520, 200]
    },
    {
      "parameters": {
        "model": "gpt-4",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are a professional scriptwriter specializing in short-form cinematic video content. Create compelling, emotionally engaging scripts that fit within 30 seconds of spoken content (approximately 75-85 words)."
            },
            {
              "role": "user",
              "content": "=Create a 30-second cinematic video script.\n\nHook: {{ $json.Hook }}\nMain Idea: {{ $json['Main Idea'] }}\nTone: {{ $json['Tone/Style'] }}\n\nRequirements:\n- Maximum 80 words for 30-second delivery\n- Clear scene breaks marked with [SCENE X]\n- Strong opening hook (first 3 seconds)\n- Emotional beats throughout\n- Powerful closing CTA\n- Mark [INTRO] and [OUTRO] for talking head segments\n\nFormat:\n[INTRO] - Opening talking head text\n[SCENE 1] - Description\n...\n[OUTRO] - Closing talking head text"
            }
          ]
        }
      },
      "id": "script-generation",
      "name": "Generate Initial Script",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [540, 300],
      "credentials": {
        "openAiApi": {
          "id": "openai-credentials",
          "name": "OpenAI API"
        }
      }
    },
    {
      "parameters": {
        "model": "gpt-4",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are a script editor. Refine scripts for clarity, pacing, and emotional impact. Ensure exactly 30 seconds of spoken content."
            },
            {
              "role": "user",
              "content": "=Refine this script to EXACTLY 30 seconds (75-80 words max):\n\n{{ $json.message.content }}\n\nEnsure:\n- Punchy, clear sentences\n- Perfect pacing for voiceover\n- Strong emotional beats\n- Scene transitions that flow cinematically\n\nOutput the final script with scene markers."
            }
          ]
        }
      },
      "id": "script-refinement",
      "name": "Refine Script to 30s",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [760, 300],
      "credentials": {
        "openAiApi": {
          "id": "openai-credentials",
          "name": "OpenAI API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const script = $input.first().json.message.content;\n\n// Parse scenes from script\nconst scenes = [];\nconst sceneRegex = /\\[SCENE\\s*(\\d+)\\]([^\\[]*)/gi;\nconst introRegex = /\\[INTRO\\]([^\\[]*)/i;\nconst outroRegex = /\\[OUTRO\\]([^\\[]*)/i;\n\n// Extract intro\nconst introMatch = script.match(introRegex);\nif (introMatch) {\n  scenes.push({\n    type: 'intro',\n    number: 0,\n    text: introMatch[1].trim(),\n    filename: '01_START'\n  });\n}\n\n// Extract scenes\nlet match;\nlet sceneNum = 2;\nwhile ((match = sceneRegex.exec(script)) !== null) {\n  scenes.push({\n    type: 'scene',\n    number: parseInt(match[1]),\n    text: match[2].trim(),\n    filename: String(sceneNum).padStart(2, '0')\n  });\n  sceneNum++;\n}\n\n// Extract outro\nconst outroMatch = script.match(outroRegex);\nif (outroMatch) {\n  scenes.push({\n    type: 'outro',\n    number: 99,\n    text: outroMatch[1].trim(),\n    filename: String(sceneNum).padStart(2, '0') + '_END'\n  });\n}\n\nreturn {\n  fullScript: script,\n  scenes: scenes,\n  sceneCount: scenes.length,\n  introText: introMatch ? introMatch[1].trim() : '',\n  outroText: outroMatch ? outroMatch[1].trim() : ''\n};"
      },
      "id": "parse-script",
      "name": "Parse Script Scenes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [980, 300]
    },
