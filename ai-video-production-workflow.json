    {
      "parameters": {
        "jsCode": "// Generate FFmpeg concat file and command\nconst files = $input.all().map(item => item.json);\n\n// Sort by filename\nfiles.sort((a, b) => {\n  const aNum = parseInt(a.filename.replace(/\\D/g, '')) || 0;\n  const bNum = parseInt(b.filename.replace(/\\D/g, '')) || 0;\n  return aNum - bNum;\n});\n\n// Create concat list\nlet concatList = '';\nfor (const file of files) {\n  const ext = file.type === 'scene' ? '_animated.mp4' : '.mp4';\n  concatList += `file '${file.filename}${ext}'\\n`;\n}\n\n// FFmpeg command for assembly with transitions\nconst ffmpegCmd = `ffmpeg -f concat -safe 0 -i concat_list.txt -c:v libx264 -preset medium -crf 23 -c:a aac -b:a 128k -movflags +faststart assembled_video.mp4`;\n\nreturn {\n  concatList,\n  ffmpegCommand: ffmpegCmd,\n  fileCount: files.length\n};"
      },
      "id": "prepare-assembly",
      "name": "Prepare Assembly",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3860, 300]
    },
    {
      "parameters": {
        "command": "={{ $json.ffmpegCommand }}"
      },
      "id": "ffmpeg-concat",
      "name": "FFmpeg Assembly",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [4080, 300]
    },
